# ============================================================
# Backend environment variables (PRODUCTION / STAGING — set on Render).
# Fill each value in the Render dashboard. Never commit real values here.
# For LOCAL development use .env.development (already provided, localhost-only).
# ============================================================

# ── Database ──
MONGO_URI=""

# ── Auth ──
JWT_SECRET=""
JWT_EXPIRES_IN=""
SESSION_SECRET=""

# ── Admin portal login (matched exactly in adminController) ──
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Server ──
# Leave PORT blank on Render — it injects the port automatically.
PORT=""
NODE_ENV=""

# ── Frontend URLs (CORS + links inside verification/redirect emails) ──
FRONTEND_URL=""
ADMIN_FRONTEND_URL=""
SHOPPER_FRONTEND_URL=""
SHOPKEEPER_FRONTEND_URL=""

# ── Email (Gmail OAuth). Alternative transport: set SMTP_HOST/PORT/USER/PASS. ──
GMAIL_USER=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
MAIL_FROM=""

# ── Google Maps (server-side distance / geocoding) ──
GOOGLE_MAPS_API_KEY=""


# ── File upload ──
MAX_FILE_SIZE=""
UPLOAD_PATH=""
